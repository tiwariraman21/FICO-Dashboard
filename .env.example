# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is in .gitignore, so your real keys and password never get committed.

PORT=3001

# Where the finance data is read from:
#   sample - the invented data set in server/data/sample (dated 9 Nov 2026)
#   sap    - live S/4HANA OData services (stubs only in this version)
# Approvals, fixes and reminders are always recorded in db/fico.db, whichever is chosen.
DATA_SOURCE=sample

# SAP Business Accelerator Hub sandbox, or your own system's OData root
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/
SAP_API_KEY=paste-your-sandbox-api-key-here

# --- Sign-in ---
# The backend refuses to start without both of these. Generate the hash with:
#   node server/scripts/hash-password.js "your password"
AUTH_USERNAME=you@example.com
# The name recorded against every decision and shown on screen.
AUTH_DISPLAY_NAME=Meera K
AUTH_PASSWORD_HASH=run-the-hash-password-script-to-generate-this
# true when deployed behind HTTPS; false on http://localhost or sign-in silently fails.
AUTH_SECURE_COOKIE=false

# --- Approval limits (rupees). Above these the CFO signs after the Finance Controller. ---
LIMIT_JOURNAL_ENTRY=5000000
LIMIT_INVOICE_RELEASE=10000000
LIMIT_PAYMENT_RUN=30000000

# --- Email ---
# Leave MAIL_PASSWORD empty and every action still saves; it just sends nothing.
# Microsoft 365: MAIL_HOST=smtp.office365.com MAIL_PORT=587 (SMTP AUTH must be enabled)
# Gmail: needs a 16-character App Password. Test mailbox: node server/scripts/make-test-mailbox.js
MAIL_ENABLED=true
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USER=you@example.com
MAIL_PASSWORD=
MAIL_FROM=Finance Dashboard <you@example.com>
# Catch-all: mail for anyone not in MAIL_DIRECTORY comes here, marked with who it was for.
MAIL_TO=you@example.com
# Who the people named in the data really are. Server side only, never sent to the browser.
# MAIL_DIRECTORY={"Rohit Kulkarni":"rohit@example.com","Ms. Nandini Rao":"cfo@example.com"}
MAIL_DIRECTORY=

# --- The Ask assistant ---
# Without a key, Ask still answers from the dashboard's own rules (free, exact, offline).
# With one, it becomes a conversation that can look things up across screens and offer to
# send a reminder, export a list or flag something - always asking you first.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
